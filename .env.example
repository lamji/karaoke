# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Google Cloud console -> YouTube Data API v3 key. Server only.
YOUTUBE_API_KEY=

# Public URL used in QR codes, e.g. https://your-app.vercel.app
# Leave empty to use the current browser origin.
NEXT_PUBLIC_APP_URL=
